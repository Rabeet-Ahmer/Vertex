# Next.js web workspace — environment variables
# Copy to .env.local and fill in real values. Never commit real keys/tokens.
#
# Note: the standalone Studio (studio/) also needs NEXT_PUBLIC_SANITY_PROJECT_ID
# and NEXT_PUBLIC_SANITY_DATASET in studio/.env (gitignored) so the Sanity CLI
# and typegen can resolve the project without flags.

# --- Sanity ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-10
# Server-only viewer token. Never expose to the browser, never prefix NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
